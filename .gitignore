# Virtual environment
.venv/
__pycache__/

# Local agent/tool state
.claude/
.codex/

# Secrets / API keys
.env
.env.local
.env.*.local

# Documentation & specs (local notes, not tracked)
doc_processed/

# Large rendered HTML reports (>100MB, exceeds GitHub limit)
doc/research_processed/01_data_exploration_Am.html
doc/research_processed/01_data_exploration_Ul.html

# Notebook backups (kept locally only)
*.backup.ipynb

# Data
data/raw/
data/openfacades_output/
data/output/

# osmnx / zensvi default cache dir (created when scripts run from repo root)
cache/

# Model checkpoints (large binary, regeneratable from train.py)
models/

# Background training stdout/stderr logs
logs/

# Editable install metadata (created by pip install -e)
src/*.egg-info/


# Derived EP-Online slice (regenerate with src.audit.ep_raw; source is data/raw/)
data/interim/

# MVP-era Gemini VLM test set (92 MB of Delft PNGs); the Gemini path is archived
data/processed/mvp_vlm_testing_data_gmini/

# OpenFACADES Phase 2 VLM inference outputs; that branch is not part of the thesis
data/processed/phase_2_openfacade_vlm_pipeline/

# LaTeX draft previews (rebuild from thesistemplate-main/)
output/

# LaTeX build artifacts (scoped: pipeline .log files elsewhere stay tracked)
**/thesistemplate-main*/**/*.aux
**/thesistemplate-main*/**/*.log
**/thesistemplate-main*/**/*.toc
**/thesistemplate-main*/**/*.lof
**/thesistemplate-main*/**/*.lot
**/thesistemplate-main*/**/*.out
**/thesistemplate-main*/**/*.bbl
**/thesistemplate-main*/**/*.blg
**/thesistemplate-main*/**/*.bcf
**/thesistemplate-main*/**/*.run.xml
**/thesistemplate-main*/**/*.synctex.gz

# Scratch: paper full-text dumps for Zotero gap check, and temporary PDFs
.codex-zotero-gap/
tmp/

# Local review / audit notes (not tracked)
Thesis_reports/intro_citation_audit.md
Thesis_reports/reviewer_comments_AD_JQ.md

# Codex build output inside any thesis template copy
**/thesistemplate-main*/.codex-build/

# biber save-error leftovers
**/thesistemplate-main*/**/*.bcf-SAVE-ERROR
